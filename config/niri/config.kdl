// ~/.config/niri/config.kdl  — adaptado do hyprland.conf. Validar com: niri validate
// Mod = Super (no TTY/Hyprland-like); para testar aninhado dentro do Hyprland o Mod vira Alt.

input {
    keyboard {
        xkb {
            layout "br"
            options "compose:ralt"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        // epic-mouse-v1 tinha sensibilidade -0.8 no Hyprland
        accel-speed -0.8
    }
    focus-follows-mouse
}

output "eDP-1" {
    scale 1      // era 1 no Hyprland (monitor=,preferred,auto,1); 4K em 1.0 fica minúsculo — ajuste/remova
}

layout {
    gaps 10
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring { off; }
    border {
        width 2
        active-gradient from="#fefefe" to="#2a211c" angle=45
        inactive-color "#2a211c"
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"
hotkey-overlay { skip-at-startup; }

environment {
    XCURSOR_SIZE "12"
    GTK_THEME "Adwaita:dark"
    GTK_MODE "dark"
    SDL_VIDEODRIVER "wayland"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    // GDK_BACKEND "wayland" fica de fora: quebra apps GTK via Xwayland; XDG_* é o niri que define
}

cursor {
    xcursor-size 12
}

// Workspace nomeada para o Spotify (smart-close.sh)
workspace "spotify"

spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "qs"
spawn-at-startup "udiskie" "-2"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "sh" "-c" "~/.config/quickshell/tools/wallpaper.sh start"
spawn-at-startup "sh" "-c" "until busctl --user list | grep -q org.kde.StatusNotifierWatcher; do sleep 0.5; done; exec snixembed"

// ---- comportamento padrão de novas janelas ----
window-rule {
    open-maximized false
    open-maximized-to-edges false
    open-fullscreen false
}

window-rule {
    match app-id=r#"^local\.extractprogress$"#
    open-floating true
    default-column-width { fixed 460; }
    default-window-height { fixed 300; }
}
window-rule {
    // Elden Ring: tela cheia
    match app-id=r#"^steam_app_1245620$"#
    open-fullscreen true
}
window-rule {
    // as janelas do Quickshell (layer-shell) não são janelas; nada a fazer. Cantos arredondados:
    geometry-corner-radius 7
    clip-to-geometry true
}
window-rule {
    match is-active=false
    opacity 0.9
}

// ---- fundo do overview (Mod+Tab): wallpaper desfocado do Quickshell (components/overview) ----
overview {
    backdrop-color "#00000000"
    workspace-shadow { off; }
}
layer-rule {
    match namespace="^quickshell-overview-backdrop$"
    place-within-backdrop true
}

include optional=true "~/.local/state/quickshell/niri-theme.kdl"

binds {
    // ---- apps ----
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+B { spawn "zen"; }
    Mod+N { spawn "kitty" "--hold" "nvim"; }
    Mod+O { spawn "obsidian"; }
    Mod+Space { spawn "fcitx5-remote" "-t"; }
    Mod+R { spawn "sh" "-c" "~/.config/quickshell/toggle_dock.sh"; }
    Mod+T { spawn "qs" "ipc" "call" "theme" "toggle"; }
     // páginas da dock

    // ---- janelas ----
    Mod+Q { spawn "sh" "-c" "~/.config/niri/smart-close.sh"; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Tab { toggle-overview; }
    Mod+C { center-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Ctrl+R { switch-preset-column-width; }

    // ---- foco (j/k + h/l alternativos + setas) ----
    Mod+J     { focus-column-left; }
    Mod+K     { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }

    // puxar/expulsar da coluna (substitui o split do dwindle)
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // ---- workspaces (verticais e dinâmicas) ----
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // ---- monitor / sessão ----
    Mod+D { power-off-monitors; }
    Mod+Shift+M { quit; }                 // era Mod+M (exit); Shift evita acidente
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ---- screenshots (hyprshot → nativo do niri; salvam em screenshot-path e copiam) ----
    Shift+Print       { screenshot; }
    Print             { screenshot-screen; }
    Alt+Print         { screenshot-window; }

    // ---- mídia ----
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
}
