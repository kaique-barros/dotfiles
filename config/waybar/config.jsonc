{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["bluetooth", "network", "custom/ip", "pulseaudio", "custom/power-profile", "battery", "clock"],
    "hyprland/workspaces": {
        "format": "{name}"
    },
    "network": {
        "format": "{icon}",
        "format-icons": {
            "wifi": "󰤨",
            "wifi-off": "󰤭",
            "ethernet": "󰌘",
            "disconnected": "󰌙",
            "connecting": "󰌚"
        },
        "on-click": "nm-connection-editor",
        "tooltip": true,
        "tooltip-format": "{ifname} {essid}\n{ipaddr}/{cidr}"
    },
    "bluetooth": {
        "format": "{icon}  {status}",
        "format-icons": {
            "enabled": "󰂯",
            "disabled": "󰂲"
        },
        "on-click": "blueman-manager",
        "tooltip": true,
        "tooltip-format": "{status}"
    },
    "custom/ip": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/get-ip.sh",
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/toggle-ip.sh",
        "tooltip": false
    },
    "custom/power-profile": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/get-power-profile.sh",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggle-power-profile.sh",
        "tooltip": true,
        "tooltip-format": "Clique para alternar\nSaver → Balanced → Performance"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰄞",
            "portable": "󰎆",
            "car": "󰉌",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰂉", "󰂊", "󰂋", "󰂅"],
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"]
        },
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-click": "",
        "tooltip": true,
        "tooltip-format": "{timeTo}\nCapacity: {capacity}%"
    },
    "clock": {
        "format": "{:%H:%M}  ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "spacing": 10
    }
}

